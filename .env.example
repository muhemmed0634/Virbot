# VirBot v6 Ortam Değişkenleri Şablonu
# (Burada herhangi bir gerçek anahtar veya token yer almaz)

# Discord Bot
DISCORD_TOKEN=your_bot_token_here
PREFIX=v!

# MongoDB Atlas Bağlantısı
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/virbot?retryWrites=true&w=majority

# Google Gemini AI (Yalnızca Flash ve Flash-Lite Modelleri)
GEMINI_API_KEY=your_gemini_api_key_here

# Dashboard Discord OAuth2
CLIENT_ID=your_discord_client_id_here
CLIENT_SECRET=your_discord_client_secret_here
CALLBACK_URL=http://localhost:3000/auth/callback
SESSION_SECRET=your_random_session_secret_here

# Sunucu Portu
PORT=3000